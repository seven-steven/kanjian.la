{
  "permissions": {
    "allow": [
      "Read(.github/ISSUE_TEMPLATE/navigation.yml)",
      "Read(.github/prompts/navigation-agent.md)",
      "Read(.github/prompts/navigation-agent-policy.md)",
      "Read(_data/sites.yml)",
      "Read(assets/image/logo/**)",
      "Edit(_data/sites.yml)",
      "Write(assets/image/logo/*)",
      "Bash(ruby scripts/fetch_logo.rb * --name *)"
    ],
    "deny": [
      "Read(.github/workflows/**)",
      "Read(**/*TOKEN*)",
      "Read(**/.env*)",
      "Bash(*TOKEN*)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(ruby test)",
      "Bash(ruby scripts/validate_sites.rb)",
      "Bash(ruby scripts/check_agent_diff.rb *)"
    ]
  }
}
